# ============================================================
# UNIVERSITY ERP — COMPLETE BUNDLE
# Environment Variables Template
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# ── Application ─────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Node Backend URLs ────────────────────────────────────────
# Local dev
BACKEND_NODE_URL=http://localhost:5000
# Production (your Render URL after deploy)
# BACKEND_NODE_URL=https://university-erp-node-api.onrender.com

# ── Spring Boot Backend URLs ─────────────────────────────────
# Local dev
BACKEND_SPRING_URL=http://localhost:8080
# Production (your Render URL after deploy)
# BACKEND_SPRING_URL=https://university-erp-spring-api.onrender.com

# ── MongoDB ──────────────────────────────────────────────────
# Node backend uses this
MONGO_URI=mongodb://localhost:27017/university-erp
# Spring Boot uses this (set as env var on Render)
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/university-erp
SPRING_DATA_MONGODB_DATABASE=university-erp

# ── Auth / JWT (Node backend) ────────────────────────────────
JWT_SECRET=replace_with_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# ── Vite Frontend (used at build time for Vercel) ────────────
# After deploying both backends on Render, set these to the Render URLs:
VITE_NODE_API_URL=http://localhost:5000
VITE_SPRING_API_URL=http://localhost:8080
